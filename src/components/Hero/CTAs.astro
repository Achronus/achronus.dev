---
type Props = {
  text: string;
  href: string;
};

const { text, href } = Astro.props as Props;
---

<a
  href={href}
  class="hero-cta tw-group tw-inline-flex tw-items-center tw-gap-3 tw-font-dm-mono tw-text-sm tw-tracking-wider tw-uppercase tw-text-blue-dark tw-pl-2 tw-pr-6 tw-py-2 tw-bg-white tw-border tw-border-blue-dark tw-rounded-full tw-transition-colors tw-duration-300 tw-ease-out hover:tw-bg-blue-dark hover:tw-text-white"
  data-reveal
  data-reveal-delay="3"
>
  <span
    class="hero-cta-icon tw-flex tw-items-center tw-justify-center tw-w-7 tw-h-7 tw-rounded-full tw-bg-white tw-transition-all tw-duration-300 tw-ease-out"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="tw-w-3.5 tw-h-3.5"
    >
      <circle cx="12" cy="12" r="3"></circle>
      <path
        d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
      ></path>
    </svg>
  </span>
  {text}
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hero-cta-arrow tw-transition-transform tw-duration-300 tw-ease-out"
  >
    <path d="M5 12h14M13 5l7 7-7 7"></path>
  </svg>
</a>

<style>
  .hero-cta:hover .hero-cta-arrow {
    transform: translateX(5px);
  }
  .hero-cta:hover .hero-cta-icon {
    background-color: #107ebd;
    transform: rotate(60deg);
  }
</style>
