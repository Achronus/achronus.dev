---
import { Icon } from "astro-icon/components";

type Accent = "torquoise" | "blue" | "green" | "amber" | "coral";

type Props = {
  accent: Accent;
  name: string;
  logo?: string;
  icon?: string;
};

const { accent, name, logo, icon } = Astro.props as Props;

const accentMap: Record<Accent, string> = {
  torquoise: "#1992d8",
  blue: "#107ebd",
  green: "#009486",
  amber: "#DDBA30",
  coral: "#EE4C2C",
};

const colour = accentMap[accent];
---

{
  logo ? (
    <div class="tw-w-9 tw-h-9 tw-rounded-lg tw-flex tw-items-center tw-justify-center tw-flex-shrink-0 tw-overflow-hidden">
      <img
        src={logo}
        alt={`${name} logo`}
        class="tw-w-full tw-h-full tw-object-contain"
        loading="lazy"
      />
    </div>
  ) : (
    <div
      class="tw-w-9 tw-h-9 tw-rounded-lg tw-flex tw-items-center tw-justify-center tw-flex-shrink-0"
      style={{
        backgroundColor: `${colour}1a`,
        color: colour,
      }}
    >
      {icon && <Icon name={`lucide:${icon}`} class="tw-w-[18px] tw-h-[18px]" />}
    </div>
  )
}
