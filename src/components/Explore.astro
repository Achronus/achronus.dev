---
import { getEntry, render } from "astro:content";

import SectionHeader from "@/components/SectionHeader.astro";
import WaveBg from "@/components/WaveBg.astro";

const sectionEntry = await getEntry("sections", "explore");
if (!sectionEntry) throw new Error("src/content/sections/explore.md is missing");
const { Content: SectionIntro } = await render(sectionEntry);
const section = sectionEntry.data;

const links = [
  {
    name: "GitHub",
    url: "https://github.com/Achronus",
    icon: "github",
    colour: "#181717",
  },
  {
    name: "Medium",
    url: "https://medium.com/@achronus",
    icon: "medium",
    colour: "#000000",
  },
  // {
  //   name: "LinkedIn",
  //   url: "https://www.linkedin.com/in/ryan-partridge-08b7118b/",
  //   icon: "linkedin",
  //   colour: "#0A66C2",
  // },
  // {
  //   name: "Email",
  //   url: "mailto:hello@achronus.dev",
  //   icon: "email",
  //   colour: "#1992d8",
  // },
];
---

<section
  id="explore"
  class="tw-py-28 tw-relative tw-bg-white tw-overflow-hidden"
>
  <WaveBg position="bottom-left" opacity={0.25} flip />
  <div class="tw-max-w-[960px] tw-mx-auto tw-px-8 tw-relative tw-z-10">
    <SectionHeader order={section.order} label={section.label} />

    <h2
      class="tw-text-4xl md:tw-text-5xl tw-font-bold tw-tracking-tight tw-mb-5 tw-text-black-theme tw-font-dm-sans"
      data-reveal
      data-reveal-delay="1"
    >
      {section.title}
    </h2>
    <div
      class="tw-text-base tw-text-grey tw-leading-relaxed tw-mb-12 tw-font-rubik tw-font-light [&_strong]:tw-text-black-theme [&_strong]:tw-font-medium"
      data-reveal
      data-reveal-delay="2"
    >
      <SectionIntro />
    </div>

    <div
      class="tw-flex tw-gap-3 tw-flex-wrap"
      data-reveal
      data-reveal-delay="3"
    >
      {
        links.map((link) => (
          <a
            href={link.url}
            target={link.icon === "email" ? "_self" : "_blank"}
            rel={link.icon === "email" ? "" : "noopener noreferrer"}
            class="explore-link tw-group tw-inline-flex tw-items-center tw-gap-3 tw-font-dm-mono tw-text-sm tw-tracking-wider tw-uppercase tw-pl-2 tw-pr-6 tw-py-2 tw-bg-white tw-border tw-rounded-full tw-transition-colors tw-duration-300 tw-ease-out"
            style={`color: ${link.colour}; border-color: ${link.colour}; --brand: ${link.colour};`}
          >
            <span class="explore-link-icon tw-flex tw-items-center tw-justify-center tw-w-7 tw-h-7 tw-rounded-full tw-text-white tw-transition-colors tw-duration-300">
              {link.icon === "github" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="tw-w-3.5 tw-h-3.5"
                >
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                </svg>
              )}
              {link.icon === "medium" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="tw-w-3.5 tw-h-3.5"
                >
                  <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z" />
                </svg>
              )}
              {link.icon === "linkedin" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="tw-w-3.5 tw-h-3.5"
                >
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              )}
              {link.icon === "email" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="tw-w-3.5 tw-h-3.5"
                >
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              )}
            </span>
            {link.name}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="explore-link-arrow tw-transition-transform tw-duration-300 tw-ease-out"
            >
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .explore-link-icon {
    background-color: var(--brand);
  }
  .explore-link:hover {
    background-color: var(--brand) !important;
    color: #ffffff !important;
  }
  .explore-link:hover .explore-link-icon {
    background-color: #ffffff;
    color: var(--brand);
  }
  .explore-link:hover .explore-link-arrow {
    transform: translateX(5px);
  }
</style>
